# URL del endpoint de Google Apps Script del catálogo "Sync"
# (pestañas: Ejecutivos, Materiales, InvConsolidado, InvDetalle).
#
# Copia este archivo a ".env.local" y coloca la URL real:
#   cp .env.example .env.local
#
# ".env.local" está en .gitignore — NUNCA lo comitees.
VITE_APPSCRIPT_URL=https://script.google.com/macros/s/AKfycbyKHV5B688DxpaPyly9Kr8W6Osnqrg7nceEma5cialZH4w5z3K0FhJsSzGpQbmq8cWY3Q/exec

# Supabase (fase 1 de la migración): historial, settings y logs por usuario.
# La clave "publishable"/anon es segura de exponer en el cliente — el acceso
# real está controlado por las políticas RLS en la base, no por esta clave.
VITE_SUPABASE_URL=https://fiplfsuhsqibzrpvjvbx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# API que reemplaza Streamlit (Sugerencias_SQL/api.py) — ver src/services/reportGeneratorService.ts
VITE_REPORT_API_URL=http://localhost:8000

# Endpoint de Apps Script (doPost) que agrega renglones a la pestaña "DRP" del
# Sheet de seguimiento — ver src/services/drpService.ts y docs/apps-script-drp.md
# para el código a desplegar. Si se omite, se reutiliza VITE_APPSCRIPT_URL.
VITE_DRP_WEBHOOK_URL=https://script.google.com/macros/s/TU_DEPLOYMENT_ID/exec
# Token compartido que el doPost valida antes de escribir (evita que cualquiera
# con la URL pueda escribir en el Sheet). Debe coincidir con el SCRIPT_TOKEN del Apps Script.
VITE_DRP_TOKEN=cambia-este-token
# ID del Google Sheet donde doPost escribe (la pestaña "DRP"). Cambiarlo acá
# no requiere re-deploy del front.
VITE_DRP_SHEET_ID=cambia-este-sheet-id

# Endpoint de Apps Script (doGet) que sirve la pestaña "IncrementoCostos" del
# Sheet de incremento de costos de proveedor (Código, Descripcion DEGASA,
# Sector, Grupo Articulo, Costo Anterior/Nuevo Pieza/Caja) — ver
# src/services/incrementoService.ts y docs/apps-script-incremento.md para el
# código a desplegar. Distinto Sheet de los anteriores.
VITE_INCREMENTO_URL=https://script.google.com/macros/s/TU_DEPLOYMENT_ID/exec

# Endpoint de Apps Script (doGet) del módulo "Seg. de pedidos": sirve crudas las hojas de los libros de
# Google Sheets Seg pedidos, Disponibilidad e Inv_Condicion (Corta caducidad, Cosmopark, PNC, Sustituto,
# Revision...) — ver src/services/pedidosService.ts y docs/apps-script-pedidos.md para el código a
# desplegar. Distinto Apps Script (y distinto Sheet) de los anteriores. También editable en /admin ·
# Conectores (clave pedidos_sheets_url); esta variable es el respaldo.
VITE_PEDIDOS_URL=https://script.google.com/macros/s/TU_DEPLOYMENT_ID/exec

# Saltar el login con Google en AuthGate (fail-closed). Si NO se define o es
# distinto de "true", el login con Google queda ACTIVO. Solo úsalo en "true"
# temporalmente para diagnosticar un problema post-login. El sistema de
# roles/permisos y el módulo /admin (ver supabase/migrations/0002_*.sql)
# requieren una sesión real de Supabase — con "true" la app entra como usuario
# anónimo y las políticas RLS bloquean toda lectura/escritura de esas tablas.
# No definas esta variable en producción.
# VITE_AUTH_DISABLED=true

# URLs opcionales para el launcher card del .exe del SugeridorAPI. Defaults
# publish the maintainers' public GitHub release.
# VITE_SUGERIDOR_EXE_URL=https://github.com/vrcomas-cmyk/Sugerencias_SQL/releases/latest/download/SugeridorAPI.exe
# VITE_SUGERIDOR_ENV_URL=https://raw.githubusercontent.com/vrcomas-cmyk/Sugerencias_SQL/main/.env.example

# Proxy de datos (acceso por roles): "on" = la app pide los datos a la Edge Function `datos` de Supabase, que valida al usuario y recorta la respuesta según su rol,
# en vez de llamar directo a los Apps Script. Activar SOLO después de desplegar la función y de configurar el token en los Apps Script
# (docs/acceso-por-roles.md). Con "on" las variables VITE_*_URL de los Apps Script dejan de usarse (y conviene quitarlas del build).
# VITE_DATOS_PROXY=on
